# Include cmake build instructions
include CMakeLists.txt

# Vendor package header files
recursive-include include *.h
recursive-include include *.hpp

# Vendor package source files (excluding R-specific)
recursive-include src *.cpp
recursive-include src *.h
exclude src/cpp11.cpp src/forest.cpp src/kernel.cpp src/R_data.cpp src/R_random_effects.cpp src/R_utils.cpp src/sampler.cpp src/serialization.cpp src/stochtree_types.h

# Remove the CRAN extensionless LICENSE file
exclude LICENSE

# Remove egg info
prune stochtree.egg-info

# Vendor boost_math header files in PyPI source distribution
recursive-include deps/boost_math/include *.hpp
recursive-include deps/boost_math/include *.h

# Vendor pybind11 dependencies in PyPI source distribution
recursive-include deps/pybind11/include/pybind11 *.h
recursive-include deps/pybind11/tools *
include deps/pybind11/CMakeLists.txt
include deps/pybind11/pyproject.toml
include deps/pybind11/setup.cfg
include deps/pybind11/setup.py

# Vendor fmt header files in PyPI source distribution
recursive-include deps/fmt/include/fmt *.h

# Vendor fast_double_parser header file in PyPI source distribution
include deps/fast_double_parser/include/fast_double_parser.h

# Vendor Eigen header files in PyPI source distribution
include deps/eigen/Eigen/Cholesky
include deps/eigen/Eigen/Core
include deps/eigen/Eigen/Dense
include deps/eigen/Eigen/Eigenvalues
include deps/eigen/Eigen/Geometry
include deps/eigen/Eigen/Householder
include deps/eigen/Eigen/IterativeLinearSolvers
include deps/eigen/Eigen/Jacobi
include deps/eigen/Eigen/LU
include deps/eigen/Eigen/OrderingMethods
include deps/eigen/Eigen/QR
include deps/eigen/Eigen/SVD
include deps/eigen/Eigen/Sparse
include deps/eigen/Eigen/SparseCholesky
include deps/eigen/Eigen/SparseCore
include deps/eigen/Eigen/SparseQR
include deps/eigen/Eigen/misc
include deps/eigen/Eigen/plugins
include deps/eigen/Eigen/Version
recursive-include deps/eigen/Eigen/src/Cholesky *.h *.inc
recursive-include deps/eigen/Eigen/src/Core *.h *.inc
recursive-include deps/eigen/Eigen/src/Dense *.h *.inc
recursive-include deps/eigen/Eigen/src/Eigenvalues *.h *.inc
recursive-include deps/eigen/Eigen/src/Geometry *.h *.inc
recursive-include deps/eigen/Eigen/src/Householder *.h *.inc
recursive-include deps/eigen/Eigen/src/IterativeLinearSolvers *.h *.inc
recursive-include deps/eigen/Eigen/src/Jacobi *.h *.inc
recursive-include deps/eigen/Eigen/src/LU *.h *.inc
recursive-include deps/eigen/Eigen/src/OrderingMethods *.h *.inc
recursive-include deps/eigen/Eigen/src/QR *.h *.inc
recursive-include deps/eigen/Eigen/src/SVD *.h *.inc
recursive-include deps/eigen/Eigen/src/Sparse *.h *.inc
recursive-include deps/eigen/Eigen/src/SparseCholesky *.h *.inc
recursive-include deps/eigen/Eigen/src/SparseCore *.h *.inc
recursive-include deps/eigen/Eigen/src/SparseQR *.h *.inc
recursive-include deps/eigen/Eigen/src/misc *.h *.inc
recursive-include deps/eigen/Eigen/src/plugins *.h *.inc